# /etc/smert-backup/env — settings for /usr/local/bin/smert-backup.

# smert's Coolify volume on this server.
VOLUME_DIR=/var/lib/docker/volumes/dx63m4krbosa1k4t6nitmay6-smert-data/_data

# "storagebox" is a Host entry in /root/.ssh/config (user, host, port 23, key).
RESTIC_REPOSITORY=sftp:storagebox:smert-backups

# Encrypts the backups. Keep a copy in your password manager: without it the
# backups cannot be read, e.g. after losing this server.
RESTIC_PASSWORD_FILE=/etc/smert-backup/restic-password

# The ping URL of your healthchecks.io check.
HC_PING_URL=
